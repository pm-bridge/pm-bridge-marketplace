{
  "mcpServers": {
    "gitlab": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"],
      "env": {
        "GITLAB_BASE_URL": "${user_config.base_url}",
        "GITLAB_TOKEN": "${user_config.token}",
        "GITLAB_DEFAULT_PROJECT": "${user_config.default_project}",
        "GITLAB_ENGLISH_ONLY_WRITES": "${user_config.english_only_writes}"
      }
    }
  }
}
