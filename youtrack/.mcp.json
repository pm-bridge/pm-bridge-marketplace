{
  "mcpServers": {
    "youtrack": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"],
      "env": {
        "YOUTRACK_BASE_URL": "${user_config.base_url}",
        "YOUTRACK_TOKEN": "${user_config.token}",
        "YOUTRACK_ENGLISH_ONLY_WRITES": "${user_config.english_only_writes}"
      }
    }
  }
}
