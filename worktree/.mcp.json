{
  "mcpServers": {
    "worktree": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"],
      "env": {
        "WORKTREE_REPO_PATH": "${user_config.repo_path}",
        "WORKTREE_DIR": "${user_config.worktrees_dir}",
        "WORKTREE_REMOTE": "${user_config.remote}",
        "WORKTREE_ENGLISH_ONLY_WRITES": "${user_config.english_only_writes}"
      }
    }
  }
}
